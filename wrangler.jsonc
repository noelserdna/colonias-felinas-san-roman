{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuidadores-colonias-felinas",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colonias",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Fotos privadas de las colonias (fichas y observaciones de los gatos).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "colonias-fotos" }],
  // Reintenta cada 5 minutos la corrección JEV de exámenes pendientes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "APP_NAME": "Cuidadores de Colonias Felinas · San Román de los Montes",
    "MAIL_FROM": "Ayuntamiento San Román <no-reply@example.org>",
    "JEV_MOCK": "0",
    "MAIL_MOCK": "0"
  },
  "observability": { "enabled": true }
}
