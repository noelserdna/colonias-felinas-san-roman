{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuidadores-colonias-felinas",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colonias",
      "database_id": "9465ffa3-4681-4014-9210-679745ce7c5d",
      // Base de datos local de desarrollo (wrangler dev / astro dev / --local).
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Correo del enlace de acceso: Cloudflare Email Service (avisos.colonia.dev dado de alta en Email Sending).
  "send_email": [{ "name": "EMAIL", "remote": true }],
  // Dirección propia de la web (además de *.workers.dev).
  "routes": [{ "pattern": "sanroman.colonia.dev", "custom_domain": true }],
  // Mantiene también la dirección *.workers.dev.
  "workers_dev": true,
  // Fotos privadas de las colonias (fichas y observaciones de los gatos).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "colonias-fotos" }],
  // Reintenta cada 5 minutos la corrección JEV de exámenes pendientes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "APP_NAME": "Cuidadores de Colonias Felinas · San Román de los Montes",
    "MAIL_FROM": "Colonias Felinas · San Román <no-reply@avisos.colonia.dev>",
    "JEV_MOCK": "0",
    "MAIL_MOCK": "0"
  },
  "observability": { "enabled": true },

  // Instancia de pruebas y demostración (demo.colonia.dev): mismos contenidos de San Román, con base de
  // datos y fotos propias. Se marca en toda la web y en los carnets (DEMO=1). Despliegue: npm run deploy:demo
  "env": {
    "demo": {
      "name": "cuidadores-colonias-felinas-demo",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "colonias-demo",
          "database_id": "8089df6b-94a8-46c1-9ace-e757da14482d",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL", "remote": true }],
      "routes": [{ "pattern": "demo.colonia.dev", "custom_domain": true }],
      "workers_dev": true,
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "colonias-fotos-demo" }],
      // Además del reintento de JEV, cada noche (03:00 UTC) la demo vuelve a su estado inicial.
      "triggers": { "crons": ["*/5 * * * *", "0 3 * * *"] },
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "APP_NAME": "Cuidadores de Colonias Felinas · San Román de los Montes (demo)",
        "MAIL_FROM": "Colonias Felinas · Demo <no-reply@avisos.colonia.dev>",
        "JEV_MOCK": "0",
        "MAIL_MOCK": "0",
        "DEMO": "1"
      }
    }
  }
}
