---
import Layout from "../../../layouts/Layout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import { eq } from "drizzle-orm";
import { ZodError } from "zod";
import { getDb, schema } from "../../../lib/db";
import { DOC_CATEGORIAS } from "../../../lib/db/schema";
import { saveDocument } from "../../../lib/documents";

const db = getDb();
const isNew = Astro.params.id === "nuevo";
let error: string | null = null;
let form: Record<string, string> | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  form = Object.fromEntries([...f.entries()].map(([k, v]) => [k, String(v)]));
  try {
    await saveDocument(db, isNew ? null : Number(Astro.params.id), { ...form, activo: form.activo === "on" });
    return Astro.redirect("/admin/documentos?ok=1", 303);
  } catch (e) {
    error = e instanceof ZodError ? e.issues.map((i) => i.message).join(". ") : "No se pudo guardar el documento.";
  }
}
const doc = isNew ? null : await db.query.documents.findFirst({ where: eq(schema.documents.id, Number(Astro.params.id)) });
if (!isNew && !doc) return new Response("No encontrado", { status: 404 });
const v = {
  titulo: form?.titulo ?? doc?.titulo ?? "",
  categoria: form?.categoria ?? doc?.categoria ?? "ordenanza",
  descripcion: form?.descripcion ?? doc?.descripcion ?? "",
  url: form?.url ?? doc?.url ?? "",
  fecha: form?.fecha ?? doc?.fecha ?? "",
  orden: form?.orden ?? String(doc?.orden ?? 0),
  activo: form ? form.activo === "on" : (doc?.activo ?? true),
};
---
<Layout title={isNew ? "Añadir documento" : "Editar documento"} wide>
  <p class="eyebrow">Administración · Documentos</p>
  <h1>{isNew ? "Añadir documento" : "Editar documento"}</h1>
  <AdminNav />
  {error && <div class="alert bad" role="alert" id="doc-error" tabindex="-1" data-focus-on-load>{error}</div>}
  <form method="post" class="card">
    <label for="titulo">Título</label>
    <input id="titulo" name="titulo" type="text" required maxlength="250" value={v.titulo} />
    <label for="categoria">Categoría</label>
    <select id="categoria" name="categoria">
      {Object.entries(DOC_CATEGORIAS).map(([k, label]) => <option value={k} selected={v.categoria === k}>{label}</option>)}
    </select>
    <label for="url">Enlace</label>
    <input id="url" name="url" type="url" required maxlength="2000" inputmode="url" placeholder="https://…" value={v.url} aria-describedby="url-help" />
    <small class="muted" id="url-help">Dirección de la publicación oficial: portal de transparencia, sede electrónica, BOP, BOE…</small>
    <label for="descripcion">Descripción <span class="muted">(opcional)</span></label>
    <textarea id="descripcion" name="descripcion" maxlength="1000">{v.descripcion}</textarea>
    <div class="row" style="align-items:flex-start">
      <div style="flex:1;min-width:min(180px,100%)">
        <label for="fecha">Fecha del documento <span class="muted">(opcional)</span></label>
        <input id="fecha" name="fecha" type="date" value={v.fecha} />
      </div>
      <div style="flex:1;min-width:min(140px,100%)">
        <label for="orden">Orden dentro de la categoría</label>
        <input id="orden" name="orden" type="number" min="0" value={v.orden} />
      </div>
    </div>
    <label class="check"><input type="checkbox" name="activo" checked={v.activo} /> Publicado (visible para la ciudadanía)</label>
    <div class="row" style="margin-top:1rem">
      <button class="btn primary" type="submit">Guardar documento</button>
      <a class="btn ghost" href="/admin/documentos">Cancelar</a>
    </div>
  </form>
</Layout>
