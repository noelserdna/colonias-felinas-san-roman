---
import Layout from "../../layouts/Layout.astro";
import SolicitudForm from "../../components/SolicitudForm.tsx";

const BOP_COLONIAS_URL = "https://bop.diputoledo.es/webEbop/DocGet?id=24065992%3B0&insert_number=3274&insert_year=2024";
const b = Astro.locals.branding;
const user = Astro.locals.user!;
const q = Astro.url.searchParams.get("anexo");
const anexo = q === "ii" ? "ii" : q === "aut" ? "aut" : "i";
const nombre = [user.nombre, user.apellidos].filter(Boolean).join(" ");
// El PDF se genera en el navegador con el escudo en PNG; el escudo por defecto tiene una versión @2x más nítida.
const escudoSrc = b.escudo.custom ? b.escudo.src : "/img/escudo@2x.png";
const titulo = { i: "Solicitud de registro de una colonia", ii: "Solicitud de alta como colaborador/a", aut: "Autorización de la persona propietaria" }[anexo];
const blanco = {
  i: "/docs/anexo-i-solicitud-registro-colonia.pdf",
  ii: "/docs/anexo-ii-solicitud-alta-colaborador.pdf",
  aut: "/docs/autorizacion-propietario-terreno.pdf",
}[anexo];
---
<Layout title={titulo}>
  <p class="eyebrow"><a href="/colonia">Mi colonia</a></p>
  <h1>Rellenar la solicitud</h1>
  <nav class="segmented" aria-label="Formulario">
    <a href="/colonia/solicitud" aria-current={anexo === "i" ? "page" : undefined}>Anexo I · Registro de colonia</a>
    <a href="/colonia/solicitud?anexo=ii" aria-current={anexo === "ii" ? "page" : undefined}>Anexo II · Alta como colaborador/a</a>
    <a href="/colonia/solicitud?anexo=aut" aria-current={anexo === "aut" ? "page" : undefined}>Autorización de la persona propietaria</a>
  </nav>
  <p>
    {{
      i: "Rellena los datos, descarga el PDF y preséntalo firmado en el Ayuntamiento. Es el Anexo I de la ordenanza de colonias felinas.",
      ii: "Con el Anexo II solicitas colaborar en el proyecto CER. Preséntalo firmado en el Ayuntamiento junto con una fotocopia de tu DNI.",
      aut: "Si la colonia está en un terreno privado, la ordenanza exige la autorización expresa de la persona propietaria (apartado 7.1.4). Este es un modelo orientativo: la persona propietaria lo firma y se presenta junto con el Anexo I y una fotocopia de su DNI.",
    }[anexo]}
    {" "}¿Prefieres hacerlo a mano?{" "}
    <a href={blanco} download>
      Descarga el formulario en blanco (PDF)
    </a>. Texto oficial en el <a href={BOP_COLONIAS_URL} target="_blank" rel="noopener">BOP de Toledo<span class="sr-only"> (se abre en una ventana nueva)</span></a>.
  </p>
  <SolicitudForm client:only="react" anexo={anexo} municipio={b.municipio} escudoSrc={escudoSrc} nombre={nombre} email={user.email} />
</Layout>
